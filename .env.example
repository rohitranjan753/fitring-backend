PORT=3000

# Local Postgres default — matches `createdb fitring` with no password set.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitring
DB_SSL=false

# Auto-creates the schema from the TypeORM entities on boot. Fine for
# local/dev use; turn off once you're managing migrations by hand.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Replace with a real random value before this ever leaves your machine —
# see README for how (`openssl rand -base64 48`).
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
